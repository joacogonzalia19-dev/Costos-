# Copiá este archivo a ".env" y completá tus datos.
# La app funciona sin esto (modo manual), pero para conectar tu tienda real
# de Tienda Nube necesitás estas tres variables.

# Puerto donde corre el servidor local.
PORT=3000

# Store ID de tu tienda en Tienda Nube (el número que aparece en la URL del
# panel de administración, o en la sección de tu app privada).
TN_STORE_ID=

# Access Token de una "aplicación privada" creada para tu propia tienda desde
# el panel de Tienda Nube (Configuración > Mis aplicaciones).
TN_ACCESS_TOKEN=

# Tienda Nube pide identificar la app y un contacto en el header User-Agent.
TN_USER_AGENT=Costos- App (tu-email@ejemplo.com)
