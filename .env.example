# Copiá este archivo a ".env" y completá tus datos.

# Puerto donde corre el servidor local (no aplica en Vercel).
PORT=3000

# --- Obligatorias (la app no arranca sin esto) ---

# Base de datos Upstash Redis (gratis). Creála en https://console.upstash.com
# (o conectala desde el marketplace de Vercel, que las carga solas) y pegá acá
# las credenciales de la sección "REST API" de tu base.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Contraseña para entrar a la app. Elegí una que no uses en otro lado.
APP_PASSWORD=

# Cadena secreta para firmar la cookie de sesión — cualquier texto largo y
# aleatorio (ej. generalo con: openssl rand -hex 32). Si la cambiás, se
# cierran todas las sesiones activas.
SESSION_SECRET=

# --- Tienda Nube (opcional) ---

# Store ID de tu tienda en Tienda Nube. Ver README para cómo encontrarlo.
TN_STORE_ID=

# Access Token de una "aplicación a medida" creada desde el panel de tu
# tienda (menú lateral "Aplicaciones a medida" > "Crear aplicación a medida").
TN_ACCESS_TOKEN=

# Tienda Nube pide identificar la app y un contacto en el header User-Agent.
TN_USER_AGENT=Costos- App (tu-email@ejemplo.com)

# Sólo si usás el flujo OAuth (Partner Portal) en vez de "Aplicación a
# medida" — ver README, sección "Opción 1".
TN_CLIENT_ID=
TN_CLIENT_SECRET=
